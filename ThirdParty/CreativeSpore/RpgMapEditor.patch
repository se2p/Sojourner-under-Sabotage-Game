diff --git a/Assets/CreativeSpore/RpgMapEditor/Scripts/Extra/FollowObjectBehaviour.cs b/Assets/CreativeSpore/RpgMapEditor/Scripts/Extra/FollowObjectBehaviour.cs
--- a/Assets/CreativeSpore/RpgMapEditor/Scripts/Extra/FollowObjectBehaviour.cs
+++ b/Assets/CreativeSpore/RpgMapEditor/Scripts/Extra/FollowObjectBehaviour.cs
@@ -28,0 +29,13 @@
+		/// <summary>
+		/// Instantly centre the camera on the target and clear the SmoothDamp
+		/// velocity, so there is no visible catch-up after a teleport.
+		/// </summary>
+		public void SnapToTarget()
+		{
+			if (!Target) return;
+			if (m_camera == null) m_camera = GetComponent<Camera>();
+			Vector3 point = m_camera.WorldToViewportPoint(Target.position);
+			Vector3 delta = Target.position - m_camera.ViewportToWorldPoint(new Vector3(0.5f, 0.5f, point.z));
+			transform.position += delta;
+			velocity = Vector3.zero;
+		}
